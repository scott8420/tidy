<?xml version="1.0" encoding="UTF-8"?>
<!-- Tidy resource bundle (from Cairn's resource pipeline). Icons resolve out of
     the binary: App points the icon theme at /io/github/scott8420/Tidy/icons and
     GTK appends scalable/apps/ itself. Symbolic icons recolour to the
     foreground; the tidy-hero-* emblems are full colour, each in its page's
     tint. The look's stylesheet rides in the second prefix. -->
