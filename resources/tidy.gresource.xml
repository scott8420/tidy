    <file preprocess="xml-stripblanks" alias="tidy-hero-activity.svg">icons/scalable/apps/tidy-hero-activity.svg</file>
    <file preprocess="xml-stripblanks" alias="tidy-hero-archive.svg">icons/scalable/apps/tidy-hero-archive.svg</file>
